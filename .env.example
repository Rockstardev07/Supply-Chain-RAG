# Recommended, free: get a Gemini API key at https://aistudio.google.com/apikey
# (no credit card needed). This project uses it for both embeddings and answering.
GEMINI_API_KEY=your_gemini_key_here

# Optional. Only used as a fallback for ANSWERING (not embeddings) if
# GEMINI_API_KEY is missing, or if a Gemini answer call fails at runtime.
# Leave blank if you don't have one.
OPENAI_API_KEY=
